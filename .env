COMPOSE_PROJECT_NAME=phpapp4
TZ=America/Mexico_City

POSTGRES_DB=phpapp4
POSTGRES_USER=phpapp4
POSTGRES_PASSWORD=phpapp4


app.baseURL = 'http://newapp.test/'
app.indexPage = ''
app.defaultLocale = 'es'
app.appTimezone = ${TZ}

CI_ENVIRONMENT = development
logger.threshold = 4

database.default.DBDriver = Postgre
database.default.hostname = postgres
database.default.port = 5432
database.default.charset = utf8
database.default.database = ${POSTGRES_DB}
database.default.username = ${POSTGRES_USER}
database.default.password = ${POSTGRES_PASSWORD}

